{
  "manifest_version": 3,
  "name": "Luduvo Addons",
  "version": "1.0",
  "web_accessible_resources": [
    {
      "resources": [
        "custom.js"
      ],
      "matches": [
        "https://*.luduvo.com/*"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.luduvo.com/*"
      ],
      "js": [
        "components/components.js",
        "utils.js",
        "custom.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://*.luduvo.com/*"
      ],
      "js": [
        "components/components.js",
        "utils.js",
        "main.js",
        "plugins/noSubscriptions.js",
        "plugins/uiFix.js",
        "plugins/test.js",
        "plugins/inboxCategories.js"
      ],
      "css": [
        "components/button.css",
        "components/textarea.css",
        "components/dialog.css"
      ]
    }
  ]
}